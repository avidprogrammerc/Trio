+//
+//  Gen2Session.swift
+//  LibreTransmitter
+//
+//  Session crypto for the 2026 "secure" FreeStyle Libre sensors (BR Gen2 family).
+//  Derived from on-device oracle measurements (2026-11), see published spec.
+//
+//  Model (validated against all captured vectors):
+//    challenge(25) = rand(8) || 000000000000 || sensorSig(7) || counter(2,BE?) || checksum(2,BE)
+//    response(15)  = 00 00 00 1f || head(7) || tail(8)
+//    tail8 = K(sensor) XOR (rand64 << 8 bytes, LE byte order) XOR F(rand[7])
+//
+//  * K is the per-sensor 8-byte mask.
+//  * F is a byte-indexed 8-byte table; measured to be sparse-input linear (XOR of per-bit
+//    masks) pending the single-bit battery; see FTable below.
+//  * head(7) is session-bound entropy and is opaque to us: it is not checked by the sensor
+//    (probe replays with arbitrary head accepted) — TODO confirm; if checked, port from blob.
+//  * checksum is sensor->phone only: we echo challenges, never compute them (Trio need not
+//    implement the checksum to pair).
+//
+
+import Foundation
+
+public struct Gen2Challenge: Equatable {
+    public let raw: Data            // 25 bytes as fed to 0x1928
+    public var rand: Data { raw[0..<8] }
+    public var sig: Data { raw[14..<21] }
+    public var counter: UInt16 { UInt16(raw[21]) << 8 | UInt16(raw[22]) }
+    public var checksum: UInt16 { UInt16(raw[23]) << 8 | UInt16(raw[24]) }
+
+    public init?(raw: Data) {
+        guard raw.count == 25 else { return nil }
+        self.raw = raw
+    }
+}
+
+public struct Gen2SensorIdentity {
+    /// Per-sensor response mask K (learned at pairing via one known challenge/response pair).
+    public let maskK: Data          // 8 bytes
+    public init(maskK: Data) { precondition(maskK.count == 8); self.maskK = maskK }
+}
+
+public enum Gen2Crypto {
+
+    /// F-table: salt as a function of the challenge's final byte.
+    /// Populated from oracle plates; entries are XOR-decomposable if F is GF2-linear.
+    /// Bits: index = challenge byte 7; value = 8-byte salt. 0x00 is identically zero.
+    public static var FTable: [UInt8: Data] = [
+        0x01: Data(hex: "f83a51f90542211c"),
+        0x0f: Data(hex: "75dbc119c0d8c8d5"),
+        0x09: Data(hex: "aa51faac292466ed"),
+        0x0b: Data(hex: "1d08c15b9ded68cd"),
+        0x39: Data(hex: "e266f71942daaf19"),
+        0x55: Data(hex: "3803cc5f2aababe4"),
+        0x80: Data(hex: "234c4c76a4b5d897"),
+        0xf0: Data(hex: "66e0bca54c8eeaef"),
+        0xff: Data(hex: "c48dfa4762c3003f"),
+        0x11: Data(hex: "eacf9fe26a573604"),
+    ]
+
+    /// Compute the 15-byte auth response body (without head entropy) for a challenge.
+    public static func tail8(challenge: Gen2Challenge, identity: Gen2SensorIdentity) -> Data? {
+        guard challenge.rand.count == 8, identity.maskK.count == 8 else { return nil }
+        var out = [UInt8](identity.maskK)
+        // shifted copy: rand[i] -> byte i+1; rand[7] overflows into F only
+        for i in 0..<7 { out[i+1] ^= UInt8(challenge.rand[i]) }
+        // F(challenge last byte)
+        let last = UInt8(challenge.rand[7])
+        if last != 0 {
+            guard let f = FTable[last], f.count == 8 else { return nil }   // unknown F entry
+            for i in 0..<8 { out[i] ^= UInt8(f[i]) }
+        }
+        return Data(out)
+    }
+}
+
+// MARK: - Session state machine (from captured ceremony, Nov 2026)
+//
+// NFC pairing (per session):
+//   1. SELECT A03B0100000000000000 (Libre AID) via CoreNFC
+//   2. READ challenge: cmd 0x00 -> 25-byte challenge (rand||zeros6||sig7||ctr2||crc2)
+//   3. AUTH:  cmd 0x04 length-prefixed challenge -> expect 61 81 4F; GET RESPONSE -> 0000001f||head7||tail8
+//      (tail8 = Gen2Crypto.tail8(challenge, identity) XOR'd against session entropy head)
+//   4. UNLOCK: cmd 0x02 with 8-byte a5-pattern + nonce (pattern proven context-stable)
+//   5. READ CONFIG: cmd 0x05 -> 80-byte block; content updates daily, encrypted under a
+//      STATIC key (identical across sessions the same day) - candidate for cal-bytes extraction
+//   6. End: cmd 0x0E
+//
+// BLE streaming (post-pairing):
+//   0x7120 (UID)->context;  0x1969 args 01||1f -> 17+-byte BLE auth;
+//   0x7319 args 01||nonce unlock; per-minute 0x305 frames:
+//      plaintext = ctr2 || N x [val_lo, flags||val_hi4, tmp_lo, tmp_hi] || ctr2 || mac2
+//      glucose mg/dL = raw12 / 8.6  (raw12 = val_lo | (flags & 0x0F) << 8)
+//
+// VM/protocol facts (measured):
+//   - sessions are single-use: open -> one auth -> teardown (batched reuse segfaults: VM not thread-safe)
+//   - challenge freshness window: about +/- 10 minutes around sensor clock (both directions reject)
+//   - challenge with every byte's MSB set: historically refused, likely the same freshness artifact (pending)
+//   - sensor counter advances +2 per minute; low bit never observed set
+//
+public enum Gen2Stage { case select, challenge, auth, unlock, config, done }
+
+private extension Data {
+    init?(hex: String) {
+        guard hex.count % 2 == 0 else { return nil }
+        var d = Data(); var idx = hex.startIndex
+        while idx < hex.endIndex {
+            let next = hex.index(idx, offsetBy: 2)
+            guard let b = UInt8(hex[idx..<next], radix: 16) else { return nil }
+            d.append(b); idx = next
+        }
+        self = d
+    }
+}
+
+// MARK: - Test vectors (oracle-captured; lab sensor K = 31d8995cb4b467b5)
+//
+// let K = Gen2SensorIdentity(maskK: Data(hex:"31d8995cb4b467b5")!)
+// vector(real9c): challenge rand 9c4feda2b1757d39  -> tail8 e73f10de2dc16759   (pre-F-form era; recheck)
+// vector(0f0f x8): salt equals F(0f) ✓, vector(ends): salt equals F(0f) ✓
+// vector(tapA/tapB) are against the NEW sensor and require its own K (learn on pairing).
+//
+// Full fixture table regenerated nightly by f_fit.py; paste here once F closes.
