+/* gen2elf.c — run Android arm64 engine blobs (libsas.so, libDataProcessing.so)
+   on iOS/ELF-less hosts: minimal ELF64 loader + Android-JNI simulator + libc shims.
+   Built for iOS (linked into LibreTransmitter) and for qemu-aarch64 host tests. */
+#define _GNU_SOURCE
+#ifdef __APPLE__
+#define _XOPEN_SOURCE 700
+#define _DARWIN_C_SOURCE 1
+#endif
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdio.h>
+#include <stdarg.h>
+#include <dlfcn.h>
+#include <unistd.h>
+#include <fcntl.h>
+#include <sys/mman.h>
+#ifdef __APPLE__
+#define MAP_ANONYMOUS MAP_ANON
+
+#endif
+#include <strings.h>
+#include "gen2elf.h"
+#include "jni.h"
+
+/* ---------- tiny log ---------- */
+static char g_log[16384]; static int g_logn;
+static void L(const char *fmt, ...) {
+    int oldn = g_logn;
+    va_list ap; va_start(ap, fmt);
+    if (g_logn < (int)sizeof(g_log) - 512)
+        g_logn += vsnprintf(g_log+g_logn, sizeof(g_log)-g_logn, fmt, ap);
+    va_end(ap);
+    fputs(g_log+oldn, stderr);
+}
+const char *gen2elf_log(void) { return g_log; }
+static int g_trace = 1;
+
+/* ---------- minimal ELF64 ---------- */
+typedef struct { uint8_t id[16]; uint16_t type,mach; uint32_t ver; uint64_t entry,phoff,shoff;
+    uint32_t flags; uint16_t ehsize,phentsz,phnum,shentsz,shnum,shstrndx; uint16_t _pad; } Ehdr;
+typedef struct { uint32_t type,flags; uint64_t off,vaddr,paddr,fsz,msz,align; } Phdr;
+typedef struct { uint32_t name; uint8_t info,other; uint16_t shndx; uint64_t value,size; } Sym;
+typedef struct { uint64_t offset,info,addend; } Rela;
+#define PT_LOAD 1
+#define PT_DYNAMIC 2
+#define DT_NULL 0
+#define DT_SYMTAB 6
+#define DT_RELA 7
+#define DT_RELASZ 8
+#define DT_RELAENT 9
+#define DT_STR_TAB_5 5
+#define DT_INIT_ARRAY 25
+#define DT_INIT_ARRAYSZ 27
+#define R_RELATIVE 1027
+#define R_GLOB_DAT 1025
+#define R_JUMP_SLOT 1026
+#define R_ABS64 257
+
+typedef struct img {
+    struct img *next;
+    char name[64];
+    uint8_t *base;            /* mapped span */
+    uint64_t lo, hi;
+    Ehdr *eh; Phdr *ph; int phnum;
+    Sym *sym; char *str;      /* .dynsym/.dynstr (post-reloc addresses) */
+    void **initarr; int ninit;
+    Rela *rela; size_t relasz;
+    Rela *jmprel; size_t jmprelsz;
+    int is_dp; int raw;
+} img;
+static img *g_imgs;
+
+static img *img_find(const char *n) {
+    img *fuzzy = 0;
+    for (img *i = g_imgs; i; i = i->next) {
+        if (i->raw) continue;
+        if (!strcmp(i->name, n)) return i;
+        if (!fuzzy && (strstr(i->name, n) || strstr(n, i->name))) fuzzy = i;
+    }
+    return fuzzy;
+}
+
+/* dynsym iteration: bounded by DT hash? we lack it — walk until str bounds; cap 60000 */
+static void *sym_in(img *m, const char *name) {
+    if (!m->sym || !m->str) return 0;
+    for (int k = 0; k < 60000; k++) {
+        Sym *s = &m->sym[k];
+        if (s->name == 0) { if (k > 4096) break; continue; }
+        if (s->name > 1u<<20) break;           /* strtab overrun heuristic */
+        const char *sn = m->str + s->name;
+        if (!strcmp(sn, name) && s->value)
+            return (void *)(m->base + s->value);
+    }
+    return 0;
+}
+
+static void stripv(char *d, const char *s) {
+    int i = 0; while (s[i] && s[i] != '@') { d[i] = s[i]; i++; } d[i] = 0;
+}
+
+/* ---------- libc/android shims ---------- */
+static char g_cache_prefix[256] = "/tmp";
+static FILE *g_fakes[64]; static int g_nfakes;
+
+static int my_aslog(int prio, const char *tag, const char *fmt, ...) {
+    va_list ap; va_start(ap, fmt);
+    (void)prio; (void)tag;
+    if (g_logn < (int)sizeof(g_log)-512)
+        g_logn += vsnprintf(g_log+g_logn, sizeof(g_log)-g_logn, fmt, ap);
+    g_logn += snprintf(g_log+g_logn, sizeof(g_log)-g_logn, "\n");
+    va_end(ap); return 0;
+}
+static int my_aslogv(int prio, const char *tag, const char *fmt, va_list ap) {
+    (void)prio;(void)tag;
+    if (g_logn < (int)sizeof(g_log)-512)
+        g_logn += vsnprintf(g_log+g_logn, sizeof(g_log)-g_logn, fmt, ap);
+    return 0;
+}
+static int32_t my_sysprop_get(const char *key, char *value) { (void)key; value[0]=0; return 0; }
+static unsigned long my_getauxval(unsigned long t) { (void)t; return 0; }
+static void my_nop(void) {}
+static int fp_is_mine(FILE *f) { for (int i=0;i<g_nfakes;i++) if (g_fakes[i]==f) return 1; return 0; }
+
+
+/* --- tiny read-only mem-FILE for /proc shims (iOS 15 lacks fmemopen) --- */
+#ifdef __APPLE__
+typedef struct { const char *p; size_t n, c; } MSTREAM;
+static MSTREAM g_ms[8]; static int g_nms;
+static int ms_read(void *vc, char *buf, int n_) { size_t n = (size_t)n_;
+    MSTREAM *m = (MSTREAM*)vc;
+    size_t av = m->c < m->n ? m->n - m->c : 0;
+    if (n > av) n = av;
+    memcpy(buf, m->p + m->c, n); m->c += n;
+    return (int)n;
+}
+static fpos_t ms_seek(void *vc, fpos_t off, int wh) {
+    MSTREAM *m = (MSTREAM*)vc;
+    fpos_t t = wh == SEEK_SET ? off : wh == SEEK_CUR ? (fpos_t)m->c + off : (fpos_t)m->n + off;
+    if (t < 0) return -1; m->c = (size_t)t; return t;
+}
+static int ms_close(void *vc) { (void)vc; return 0; }
+static FILE *my_fmemopen(const void *buf, size_t n, const char *mode) {
+    if (g_nms >= 8) return 0;
+    MSTREAM *m = &g_ms[g_nms++]; m->p = (const char*)buf; m->n = n; m->c = 0;
+    return funopen(m, ms_read, 0, ms_seek, ms_close);
+}
+#else
+static FILE *my_fmemopen(const void *buf, size_t n, const char *mode) { return fmemopen((void*)buf, n, mode); }
+#endif
+static FILE *my_fopen(const char *path, const char *mode) {
+    char red[512];
+    if (!strncmp(path, "/proc/", 6)) {
+        static const char cl[] = "Trio";
+        FILE *f = my_fmemopen(cl, sizeof cl, "r");
+        if (f && g_nfakes < 64) g_fakes[g_nfakes++] = f;
+        return f;
+    }
+    if (!strncmp(path, "/data/data/", 11) || !strncmp(path, "/data/user/", 11)) {
+        const char *tail = strrchr(path, '/'); if (!tail) tail = "";
+        snprintf(red, sizeof red, "%s%s", g_cache_prefix, tail);
+        path = red;
+    }
+    FILE *f = fopen(path, mode);
+    if (f && g_nfakes < 64) g_fakes[g_nfakes++] = f;
+    return f;
+}
+static size_t my_fwrite(const void *b, size_t s, size_t n, FILE *f) {
+    if (!fp_is_mine(f)) return s*n;
+    return fwrite(b,s,n,f);
+}
+static int my_fprintf(FILE *f, const char *fmt, ...) {
+    va_list ap; va_start(ap, fmt);
+    int r;
+    if (fp_is_mine(f)) r = vfprintf(f, fmt, ap);
+    else { if (g_logn<(int)sizeof(g_log)-512)
+               g_logn += vsnprintf(g_log+g_logn,sizeof(g_log)-g_logn,fmt,ap); r = 1; }
+    va_end(ap); return r;
+}
+static int my_fflush(FILE *f) { return fp_is_mine(f) ? fflush(f) : 0; }
+static int my_fputc(int c, FILE *f) { return fp_is_mine(f) ? fputc(c,f) : c; }
+static int my_fputs(const char *s, FILE *f) { if (!fp_is_mine(f)) return 0; return fputs(s,f); }
+static int my_open2(const char *p, int fl) { (void)fl; return open(p, O_RDONLY); }
+static ssize_t my_read_chk(int fd, void *b, size_t n, size_t bn) { (void)bn; return read(fd,b,n); }
+static void *my_mcpy_chk(void *d, const void *s, size_t n, size_t bn) { (void)bn; return memcpy(d,s,n); }
+static int my_vsnpc(char *b, size_t n, int flags, size_t slen, const char *f, va_list ap) { (void)flags; (void)slen; return vsnprintf(b,n,f,ap); }
+static void my_scf(void) { L("gen2elf: stack-chk\n"); abort(); }
+typedef struct { uint64_t m0,m1,m2,m3; char *p; char *r0; int r1; int r2; } AFILE;
+static AFILE g_sF[3];
+static int g_sF_init_done;
+static void sF_init(void) {
+    if (g_sF_init_done) return; g_sF_init_done = 1;
+    FILE *h[3] = { stdin, stdout, stderr };
+    for (int i = 0; i < 3; i++) {
+        char *lo = (char*)h[i], *hi = lo + 512;
+        uint64_t *w = (uint64_t*)h[i];
+        for (char *q = lo; q + 8 <= hi; q += 8) {
+            uint64_t v; memcpy(&v, q, 8);
+            if (v >= (uint64_t)(uintptr_t)h[i] + 16 && v < (uint64_t)(uintptr_t)h[i] + 512) {
+                g_sF[i].p = (char*)v;            /* heuristic current-buffer cursor */
+                break;
+            }
+        }
+        g_sF[i].r1 = 0;
+    }
+}
+
+static void *my_dlopen(const char*, int);
+static void *my_dlsym(void*, const char*);
+static void my_dlclose(void*);
+static const char *my_dlerror(void);
+static jboolean my_exc_check(JNIEnv*);
+
+
+/* dl_iterate_phdr over OUR images (engine self-inspection expects to see itself) */
+struct my_phdr_info { uint64_t addr; const char *name; const void *phdr; uint16_t phnum;
+                      uint16_t _p1; uint32_t _p2; };
+typedef int (*phdr_cb)(struct my_phdr_info*, size_t, void*);
+static int my_dliterate(phdr_cb cb, void *data) {
+    if (getenv("GEN2ELF_NODLIT")) { L("dlit stubbed\n"); return 0; }
+    L("dlit: cb=%p data=%p\n", (void*)cb, data);
+    for (int pass = 0; pass < 2; pass++)
+    for (img *m = g_imgs; m; m = m->next) { if (m->raw) continue;
+        if ((pass == 0) != (m->name[0]==108)) continue;  /* sas first */
+        struct my_phdr_info info;
+        memset(&info, 0, sizeof info);
+        info.addr = (uint64_t)(m->base - m->lo);   /* load bias */
+        info.name = m->name;
+        info.phdr = m->ph;
+        info.phnum = (uint16_t)m->phnum;
+        L("dlit feed %s bias=%llx ph=%p n=%d\n", m->name, (unsigned long long)info.addr, (void*)info.phdr, info.phnum);
+        int r = cb(&info, 32, data);
+        L("dlit cb rc=%d\n", r);
+        if (r) return r;
+    }
+    return 0;
+}
+
+typedef struct { const char *name; void *fn; } shim;
+static shim g_shims[] = {
+    {"__android_log_print", (void*)my_aslog},
+    {"__android_log_vprint", (void*)my_aslogv},
+    {"__android_log_write", (void*)my_aslog},
+    {"__system_property_get", (void*)my_sysprop_get},
+    {"getauxval", (void*)my_getauxval},
+    {"android_set_abort_message", (void*)my_nop},
+    {"openlog", (void*)my_nop}, {"closelog", (void*)my_nop}, {"syslog", (void*)my_nop},
+    {"__register_atfork", (void*)my_nop},
+    {"fopen", (void*)my_fopen}, {"fopen64", (void*)my_fopen},
+    {"fwrite", (void*)my_fwrite}, {"fprintf", (void*)my_fprintf},
+    {"fflush", (void*)my_fflush}, {"fputc", (void*)my_fputc}, {"fputs", (void*)my_fputs},
