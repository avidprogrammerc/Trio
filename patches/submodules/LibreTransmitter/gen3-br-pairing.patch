+/* ---------- loader ---------- */
+static img *load_one(const char *name, const uint8_t *blob, size_t len, int is_dp) {
+    Ehdr *eh = (Ehdr*)blob; (void)len;
+    if (memcmp(eh->id, "\x7f" "ELF", 4) || eh->mach != 183) { L("gen2elf: %s not arm64 ELF\n", name); return 0; }
+    Phdr *ph = (Phdr*)(blob + eh->phoff);
+    uint64_t lo = ~0ull, hi = 0;
+    for (int i = 0; i < eh->phnum; i++) if (ph[i].type == PT_LOAD) {
+        if (ph[i].vaddr < lo) lo = ph[i].vaddr;
+        if (ph[i].vaddr + ph[i].msz > hi) hi = ph[i].vaddr + ph[i].msz;
+    }
+    lo &= ~0xFFFfull;
+    size_t span = (hi - lo + 0xFFF) & ~0xFFFfull;
+    if (len > span) span = (len + 0xFFF) & ~0xFFFfull;   /* whole file: shdrs + tail data */
+    uint8_t *base = mmap(0, span, PROT_READ|PROT_WRITE|PROT_EXEC, MAP_PRIVATE|MAP_ANONYMOUS, -1, 0);
+    if (base == MAP_FAILED) { L("gen2elf: mmap oom\n"); return 0; }
+    for (int i = 0; i < eh->phnum; i++) if (ph[i].type == PT_LOAD)
+        memcpy(base + (ph[i].vaddr - lo), blob + ph[i].off, ph[i].fsz);
+    img *m = calloc(1, sizeof *m);
+    snprintf(m->name, sizeof m->name, "%s", name);
+    m->base = base; m->lo = lo; m->hi = lo + span; m->is_dp = is_dp;
+    /* also register the RAW file so self-reading can succeed */
+    {
+        img *rw = calloc(1, sizeof *rw);
+        snprintf(rw->name, sizeof rw->name, "%s@raw", name);
+        rw->base = (uint8_t*)blob; rw->lo = 0; rw->hi = len;
+        /* keep ph pointing at the real header in-file */
+        rw->ph = (Phdr*)(blob + eh->phoff); rw->phnum = eh->phnum;
+        rw->is_dp = is_dp; rw->raw = 1;
+        rw->next = g_imgs; g_imgs = m; m->next = rw;   /* mapped first, raw dormant after */
+    }
+    g_imgs = m;
+    for (int i = 0; i < eh->phnum; i++) if (ph[i].type == PT_DYNAMIC) {
+        uint64_t *d = (uint64_t*)(m->base + (ph[i].vaddr - lo));
+        if (g_trace) L("  dyn@%p ph vaddr=%llx lo=%llx\n", (void*)d, (unsigned long long)ph[i].vaddr, (unsigned long long)lo);
+        for (int guard = 0; *d && guard < 200; d += 2, guard++) {
+            uint64_t tag = *d, val = d[1];
+            switch (tag) {
+                case DT_RELA:      m->rela = (Rela*)(m->base + val - lo); break;
+                case DT_RELASZ:    m->relasz = val; break;
+                case DT_SYMTAB:    m->sym = (Sym*)(m->base + val - lo); break;
+                case DT_STR_TAB_5: m->str = (char*)(m->base + val - lo); break;
+                case DT_INIT_ARRAY:    m->initarr = (void**)(m->base + val - lo); break;
+                case DT_INIT_ARRAYSZ:  m->ninit = (int)(val / sizeof(void*)); break;
+                case 23:             m->jmprel = (Rela*)(m->base + val - lo); break;   /* DT_JMPREL */
+                case 2:              m->jmprelsz = val; break;                          /* DT_PLTRELSZ */
+                default: if (g_trace) L("  DT %llu val=%llx\n", (unsigned long long)tag, (unsigned long long)val); break;
+            }
+        }
+    }
+    L("gen2elf: %s base=%p span=%zu rela=%zuB\n", name, (void*)base, span, m->relasz);
+    return m;
+}
