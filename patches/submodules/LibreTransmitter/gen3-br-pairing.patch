+/* ---- debug allocator v2: header page + data + tail guard; honest free ---- */
+#include <signal.h>
+#include <ucontext.h>
+typedef struct { uint64_t magic; uint8_t *base; size_t tot; } ALLOC_HDR;
+#define ALLOC_MAGIC 0x5A11C0ABull
+static void *dbg_alloc(size_t n, size_t align) {
+    size_t data = ((n + align - 1 + 512) + 4095) & ~4095u; if (data < 8192) data = 8192;
+    size_t tot  = 4096 + data + 4096;
+    uint8_t *m  = mmap(0, tot, PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS, -1, 0);
+    if (m == MAP_FAILED) return 0;
+    mprotect(m + 4096 + data, 4096, PROT_NONE);
+    ALLOC_HDR *h = (ALLOC_HDR*)m;
+    h->magic = ALLOC_MAGIC; h->base = m; h->tot = tot;
+    void *user = m + 4096;
+    if (align > 1 && (uintptr_t)user % align) user = (char*)user + (align - ((uintptr_t)user % align));
+    { void dbg_free_register(void*,uint8_t*,size_t); dbg_free_register(user, m, tot); }
+    return user;
+}
+static void *dbg_malloc(size_t n) { return dbg_alloc(n, 1); }
+static void *dbg_memalign(size_t al, size_t n) { return dbg_alloc(n, al < 4096 ? al : 4096); }
+static int dbg_pmal(void **p, size_t al, size_t n) { *p = dbg_memalign(al, n); return *p ? 0 : 12; }
+static void dbg_free(void *p) {
+    if (!p) return;
+    /* header is at the start of the mapping; find it by page scan back is costly -
+       user may be tail-packed, so header lives in first page: scan down to region base via tot unknown.
+       Simple: store back-pointer 16 bytes below the LOWEST possible user start: use base page anyway.
+       We placed header at m[0..24]; users can be far above it. Solve: m is page-aligned; region size unknown
+       from user ptr - so keep a tiny side table. */
+    extern void dbg_free_register(void *user, uint8_t *base, size_t tot);
+    extern void dbg_free_lookup(void *user, uint8_t **base, size_t *tot);
+    uint8_t *b; size_t t;
+    dbg_free_lookup(p, &b, &t);
+    if (b) { munmap(b, t); dbg_free_register(p, 0, 0); }
+}
+static void *dbg_realloc(void *p, size_t n) {
+    if (!p) return dbg_malloc(n);
+    void *q = dbg_malloc(n); (void)q; (void)p; return q;   /* boot-phase: leak+fresh */
+}
+static void *dbg_calloc(size_t a, size_t b) {
+    void *p = dbg_malloc(a*b); if (p) memset(p, 0, a*b); return p;
+}
+static void segv_handler(int sig, siginfo_t *si, void *uc) {
+    ucontext_t *u = (ucontext_t*)uc;
+#ifdef __APPLE__
+    unsigned long pc = (unsigned long)u->uc_mcontext->__ss.__pc;
+    unsigned long lr = 0;
+#else
+    unsigned long pc = u->uc_mcontext.pc;
+    unsigned long lr = u->uc_mcontext.regs[30];
+#endif
+    char buf[200];
+    int n = snprintf(buf, sizeof buf, "\nSEGV pc=%lx lr=%lx addr=%p\n", pc, lr, si->si_addr);
+    if (write(2, buf, n) < 0) {}
+    _exit(9);
+}
+static void install_segv(void) {
+    struct sigaction sa; memset(&sa, 0, sizeof sa);
+    sa.sa_sigaction = segv_handler; sa.sa_flags = SA_SIGINFO;
+    sigaction(SIGSEGV, &sa, 0); sigaction(SIGBUS, &sa, 0);
+}
+/* side table */
+#define SDETAB 20000
+static struct { void *u; uint8_t *b; size_t t; } g_sde[SDETAB];
+static int g_sden;
+void dbg_free_register(void *user, uint8_t *base, size_t tot) {
+    for (int i = 0; i < g_sden; i++) if (!g_sde[i].u) { g_sde[i].u=user; g_sde[i].b=base; g_sde[i].t=tot; return; }
+    if (g_sden < SDETAB) { g_sde[g_sden].u=user; g_sde[g_sden].b=base; g_sde[g_sden].t=tot; g_sden++; }
+}
+void dbg_free_lookup(void *user, uint8_t **base, size_t *tot) {
+    for (int i = 0; i < g_sden; i++) if (g_sde[i].u == user) { *base=g_sde[i].b; *tot=g_sde[i].t; return; }
+    *base = 0; *tot = 0;
+}
