+static void *resolve(const char *raw) {
+    char nm[128]; stripv(nm, raw);
+    if (!strcmp(nm, "__stack_chk_fail")) return (void*)my_scf;
+    if (!strcmp(nm, "__sF")) return (void*)g_sF;
+    for (shim *s = g_shims; s->name; s++) if (!strcmp(nm, s->name)) return s->fn;
+    if (!strcmp(nm, "__sF")) { sF_init(); return (void*)g_sF; }
+    for (img *m = g_imgs; m; m = m->next) { void *p = sym_in(m, nm); if (p) return p; }
+    for (auto struct { const char *n; void *f; } *q = 0; 0; ) (void)q;
+    for (unsigned z = 0; g_libc_map[z].n; z++) if (!strcmp(nm, g_libc_map[z].n)) return g_libc_map[z].f;
+    void *p = dlsym(RTLD_DEFAULT, nm);
+    if (p) return p;
+    L("gen2elf: UNRESOLVED %s\n", nm);
+    return 0;
+}
