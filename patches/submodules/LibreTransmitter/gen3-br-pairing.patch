+/* shared call handler: pick first jobject (JBA) from varargs/V/A forms */
+static JBA *arg_to_ba(JNIEnv *e, const jvalue *v) { (void)e; return v && ((JH*)(uintptr_t)v->l)->tag == TAGBA ? (JBA*)v->l : 0; }
