+//  Gen3Engine.swift — boot Abbott's Android Gen3 engine blobs under the ELF loader on iOS.
+//  Probe-first: tonight we only verify the engine wakes and hands us its registered natives.
+import Foundation
+import os.log
+import gen2elf
+
+public enum Gen3Engine {
+    private static let log = Logger(subsystem: "com.trio.libretransmitter.gen3", category: "engine")
+
+    public static func probeOnce() {
+        let ud = UserDefaults.standard
+        if ud.bool(forKey: "Gen3EngineProbed") { return }
+        ud.set(true, forKey: "Gen3EngineProbed")
+
+        let cache = NSSearchPathForDirectoriesInDomains(.cachesDirectory, .userDomainMask, true).first ?? NSTemporaryDirectory()
+        let rc: Int32 = gen2elf_boot(gen2_dp_blob, Int(gen2_dp_blob_len),
+                                     gen2_sas_blob, Int(gen2_sas_blob_len),
+                                     probeTransport, nil, cache)
+        var names: UnsafePointer<UnsafePointer<CChar>?>?
+        var sigs: UnsafePointer<UnsafePointer<CChar>?>?
+        let n = gen2elf_natives(&names, &sigs)
+        var listing = "rc=\(rc) natives=\(n)"
+        if let names, let sigs {
+            for k in 0..<Int(n) {
+                listing += "\n  \(String(cString: names[k]!)) \(String(cString: sigs[k]!))"
+            }
+        }
+        let tail = String(cString: gen2elf_log())
+        let report = listing + "\n---- loader log (tail) ----\n" + String(tail.suffix(4000))
+        log.log("probe: \(listing, privacy: .public)")
+        ud.set(report, forKey: "Gen3EngineProbeResult")
+        FileHandle.standardError.write(("GEN3ENGINE " + report + "\n").data(using: .utf8)!)
+        print("GEN3ENGINE-STDOUT " + listing)
+    }
+
+    private static func probeTransport(_ uctx: UnsafeMutableRawPointer?,
+                                       _ inb: UnsafePointer<UInt8>?, _ inlen: Int32,
+                                       _ out: UnsafeMutablePointer<UInt8>?, _ cap: Int32,
+                                       _ outlen: UnsafeMutablePointer<Int32>?) -> Int32 {
+        // canned 9000 while we only probe
+        if let out, cap >= 2 { out[0] = 0x90; out[1] = 0x00; outlen?.pointee = 2; return 0 }
+        return 1
+    }
+}
