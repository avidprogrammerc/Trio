+/* ---------- dl* for dp's runtime dlopen(libsas.so) ---------- */
+static void *my_dlopen(const char *fn, int f) { (void)f; return fn ? img_find(fn) : (void*)g_imgs; }
+static void my_dlclose(void *h) { (void)h; }
+static void *my_dlsym(void *h, const char *n) {
+    if (!h) { for (img *m = g_imgs; m; m = m->next) { void *p = sym_in(m, n); if (p) return p; } return 0; }
+    return sym_in((img*)h, n);
+}
+static const char *my_dlerror(void) { return "gen2elf: not found"; }
+
+/* ---------- public ---------- */
+int gen2elf_boot(const uint8_t *dp_image, size_t dp_len,
+                 const uint8_t *sas_image, size_t sas_len,
+                 gen2elf_xport xs, void *uctx,
+                 const char *cache_prefix)
+{
+    install_segv();
+    if (getenv("GEN2ELF_HOSTMALLOC")) {
+        for (unsigned z = 0; g_libc_map[z].n; z++) {
+            if (!strcmp(g_libc_map[z].n,"malloc"))  g_libc_map[z].f = (void*)malloc;
+            if (!strcmp(g_libc_map[z].n,"free"))    g_libc_map[z].f = (void*)free;
+            if (!strcmp(g_libc_map[z].n,"calloc"))  g_libc_map[z].f = (void*)calloc;
+            if (!strcmp(g_libc_map[z].n,"realloc")) g_libc_map[z].f = (void*)realloc;
+        }
+    }
+    if (cache_prefix) snprintf(g_cache_prefix, sizeof g_cache_prefix, "%s", cache_prefix);
+    g_xs = xs; g_xu = uctx;
+    if (!load_one("libsas.so", sas_image, sas_len, 0)) return 1;
+    if (!load_one("libDataProcessing.so", dp_image, dp_len, 1)) return 2;
+    for (img *m = g_imgs; m; m = m->next) if (!m->raw) relocate(m);
+    /* run init arrays: sas first (it was loaded first in our list order? reverse) */
+    img *sas = img_find("libsas"), *dp = img_find("libDataProcessing");
+    if (sas && !getenv("GEN2ELF_NOSASINIT")) run_init(sas);
+    if (dp)  run_init(dp);
+    /* JNI_OnLoad */
+    void (*onload)(JNIEnv*, void*) = (void(*)(JNIEnv*,void*))sym_in(dp, "JNI_OnLoad");
+    if (!onload) { L("gen2elf: no JNI_OnLoad\n"); return 3; }
+    JNIEnv *env = (JNIEnv*)&g_env;
+    onload(env, 0);
+    L("gen2elf: booted, natives=%d\n", g_nnat);
+    return 0;
+}
+
+void *gen2elf_native(const char *name) {
+    for (int k = 0; k < g_nnat; k++) if (!strcmp(g_nat[k].name, name)) return g_nat[k].fn;
+    return 0;
+}
+int gen2elf_natives(const char ***names, const char ***sigs) {
+    static const char *nns[MAXNAT], *sgs[MAXNAT];
+    for (int k = 0; k < g_nnat; k++) { nns[k] = g_nat[k].name; sgs[k] = g_nat[k].sig; }
+    *names = nns; *sigs = sgs; return g_nnat;
+}
+
+/* harness helper: build a JBA from raw bytes */
+jbyteArray gen2elf_mkba(const uint8_t *p, int n) {
+    JBA *a = my_NewByteArray(0, n); if (n > 0) memcpy(a->b, p, n); return (jbyteArray)a;
+}
+int gen2elf_getba(jbyteArray a, uint8_t *out, int cap) {
+    if (!a) return -1; JBA *x = (JBA*)a;
+    int n = x->len < cap ? x->len : cap; memcpy(out, x->b, n); return x->len;
+}
+
+void dlit_peek(img *m) {
+    /* scan first 4 KB of img metadata region (initarr vicinity) for heap/file pointers written post-cb */
+    for (int q = 0; q < 512; q++) {
+        uint64_t v; memcpy(&v, (uint8_t*)m + q*8, 8);
+        if (v > 0x10000 && v < 0x7fffffffffffull && (v & 7) == 0 && q < 20)
+            L("peek img+%d = %llx\n", q*8, (unsigned long long)v);
+    }
+}
