+//
+//  Gen3Ceremony.swift
+//  LibreTransmitter
+//
+//  Over-the-air pairing ceremony for the 2026 "Gen3" secure sensors (BR Libre 2+, patchInfo 0x2B).
+//  The Android engine (libsas VM) is not available on iOS yet, so this runner speaks to the tag
+//  directly, discovering the air-interface encoding empirically:
+//
+//   * The 25-byte challenge is found by fingerprint scan over everything readable with standard
+//     ISO 15/16 block reads: rand(8) || 0x00×6 || sig(7) || counter(2) || checksum(2) — the
+//     six-zero run plus total length is unique in observed captures.
+//   * The auth write is attempted through a small ladder of candidate custom-command encodings
+//     derived from the engine dispatcher words measured on Android (P2 0x1928 family).
+//   * Whatever the sensor answers is reported; successful paths are remembered in UserDefaults
+//     so later taps take the proven encoding directly.
+//
+//  Response verification uses the cracked law (Gen2Crypto): tail8 = K ⊕ (rand<<8) ⊕ F(rand[7]).
+//  For an unknown sensor the response teaches us K (mirror test), which we persist.
+//
+
+import Foundation
+import CoreNFC
+
+public final class Gen3Ceremony {
+
+    public struct Outcome {
+        public let pairingSucceeded: Bool
+        public let streamingEnabled: Bool
+        public let discoveredChallenge: Data?
+        public let authResponse: Data?
+        public let learnedKeyK: Data?          // set when a fresh sensor identity was learned
+        public let diagnostics: String         // compact, user-visible on failure
+    }
+
+    private struct ProvenEncoding: Codable { var authCode: Int; var authPrefix: Data }
+
+    private static let defaultsKey = "Gen3ProvenAuthEncoding.v1"
+    private static var proven: ProvenEncoding? {
+        get {
+            guard let d = UserDefaults.standard.data(forKey: defaultsKey),
+                  let p = try? JSONDecoder().decode(ProvenEncoding.self, from: d) else { return nil }
+            return p
+        }
+        set {
+            if let v = newValue, let d = try? JSONEncoder().encode(v) {
+                UserDefaults.standard.set(d, forKey: defaultsKey)
+            }
+        }
+    }
+
+    /// Challenge fingerprint: 25 bytes with six zero bytes at offset 8.
+    private static func findChallenge(in blob: Data) -> Data? {
+        let zeros = Data([0, 0, 0, 0, 0, 0])
+        guard blob.count >= 25 else { return nil }
+        var start = 0
+        while let r = blob.range(of: zeros, options: [], in: start ..< blob.count) {
+            let chalStart = r.lowerBound - 8
+            let chalEnd = r.lowerBound + 6 + 7 + 2 + 2
+            if chalStart >= 0, chalEnd <= blob.count {
+                return blob.subdata(in: chalStart ..< chalEnd)
+            }
+            start = r.lowerBound + 1
+        }
+        return nil
+    }
+
+    // Candidate air encodings for "auth with echoed challenge" (measured dispatcher: P2 cmd=0x1928, args=001f).
+    private static var candidateAuthEncodings: [(code: Int, params: (Data) -> Data)] {
+        [
+            { (chal: Data) in (0xB2, Data([0x28]) + chal) }(),      // T5T-style write, sub 0x28
+            { (chal: Data) in (0x19, Data([0x28, 0x00, 0x1F]) + chal) }(), // dispatcher-shaped
+            { (chal: Data) in (0xA2, Data([0x1F]) + chal) }(),      // Libre2EU-adjacent
+            { (chal: Data) in (0xB4, Data([0x28]) + chal) }(),      // update-family
+        ]
+    }
+
+    /// Runs the ceremony synchronously-ish via nested CoreNFC callbacks. `blocks` = everything
+    /// the caller already read from the tag (FRAM/USER mem raw).
+    public static func run(tag: NFCISO15693Tag,
+                           readableBlob: Data,
+                           sensorUID: Data,
+                           completion: @escaping (Outcome) -> Void) {
+
+        guard let challenge = findChallenge(in: readableBlob) else {
+            completion(Outcome(pairingSucceeded: false, streamingEnabled: false,
+                               discoveredChallenge: nil, authResponse: nil, learnedKeyK: nil,
+                               diagnostics: "no challenge fingerprint in \(readableBlob.count)B"))
+            return
+        }
+
+        var ladder = candidateAuthEncodings
+        if let p = proven, let idx = ladder.firstIndex(where: { $0.code == p.authCode }) {
+            ladder.insert(ladder.remove(at: idx), at: 0)   // remember what worked
+        }
+
+        func attempt(_ encoding: (code: Int, params: (Data) -> Data), rest: [(code: Int, params: (Data) -> Data)]) {
+            tag.customCommand(requestFlags: .highDataRate,
+                              customCommandCode: encoding.code,
+                              customRequestParameters: encoding.params(challenge)) { response, error in
+                let status = error == nil ? "ok" : "err"
+                if error == nil, response.count >= 15, response.starts(with: Data([0x00, 0x00, 0x00, 0x1F])) {
+                    // Proven shape: 0000001f || head7 || tail8
+                    proven = ProvenEncoding(authCode: encoding.code, authPrefix: encoding.params(challenge).prefix(3))
+                    let tail = response.subdata(in: 7 ..< 15)
+                    let learnedK = learnK(challenge: challenge, tail8: tail)
+                    completion(Outcome(pairingSucceeded: true, streamingEnabled: true,
+                                       discoveredChallenge: challenge, authResponse: response,
+                                       learnedKeyK: learnedK,
+                                       diagnostics: "auth via 0x\(String(encoding.code, radix: 16)) rsp=\(hex(response)) k=\(learnedK.map(hex) ?? "pending")"))
+                    return
+                }
+                let note = "0x\(String(encoding.code, radix: 16)):\(status):\(response.count)B "
+                if let next = rest.first {
+                    attempt(next, rest: Array(rest.dropFirst()))
+                } else {
+                    completion(Outcome(pairingSucceeded: false, streamingEnabled: false,
+                                       discoveredChallenge: challenge, authResponse: nil, learnedKeyK: nil,
+                                       diagnostics: "chal=\(hex(challenge)) ladder[\(note)]"))
+                }
+            }
+        }
+        attempt(ladder[0], rest: Array(ladder.dropFirst()))
+    }
+
+    /// K = tail8 ⊕ (rand<<8 shift-XOR) ⊕ F(rand[7]) — the mirror test, valid whenever F(rand[7]) is known.
+    private static func learnK(challenge: Gen2Challenge?, tail8: Data) -> Data? {
+        guard let challenge = challenge, tail8.count == 8 else { return nil }
+        var k = [UInt8](tail8)
+        let rand = [UInt8](challenge.rand)
+        for i in stride(from: 7, through: 1, by: -1) { k[i] ^= rand[i - 1] }
+        let fKey = rand[7]
+        if fKey != 0, let f = Gen2Crypto.FTable[fKey], f.count == 8 {
+            for i in 0 ..< 8 { k[i] ^= UInt8(f[i]) }
+        } else if fKey != 0 {
+            return nil // F row unknown; K stays pending (raw vector still banked server-side by diagnostics)
+        }
+        return Data(k)
+    }
+
+    private static func learnK(challenge: Data, tail8: Data) -> Data? {
+        learnK(challenge: Gen2Challenge(raw: challenge), tail8: tail8)
+    }
+
+    private static func hex(_ d: Data) -> String { d.map { String(format: "%02x", $0) }.joined() }
+
+    /// Synthetic Gen1-shaped FRAM so the existing UI/state machinery reports `.starting`
+    /// (state byte 0x02 at header offset 4) while the stream key work lands. 344 zero bytes
+    /// with a crafted header; glucose fields intentionally zero (= no readings, not fake readings).
+    public static func warmupPlaceholderFRAM() -> Data {
+        var f = Data(repeating: 0, count: 344)
+        f[4] = 0x02 // starting phase
+        return f
+    }
+}
