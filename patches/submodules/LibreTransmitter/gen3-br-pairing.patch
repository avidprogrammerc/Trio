+/* gen2elf.h — public seam: run Abbott's Android Gen3 engine on iOS. */
+#ifndef GEN2ELF_H
+#define GEN2ELF_H
+#include <stdint.h>
+#include <stddef.h>
+
+/* transport: engine asks us to talk to the sensor.
+   in = bytes engine sent (frame), out = bytes we reply. Returns 0 on success. */
+typedef int (*gen2elf_xport)(void *uctx, const uint8_t *in, int inlen,
+                             uint8_t *out, int outcap, int *outlen);
+
+int   gen2elf_boot(const uint8_t *dp_image, size_t dp_len,
+                   const uint8_t *sas_image, size_t sas_len,
+                   gen2elf_xport xs, void *uctx,
+                   const char *cache_prefix);
+/* registered-native lookup: e.g. gen2elf_native("getActivationPayload") */
+void *gen2elf_native(const char *name);
+/* list captured natives (name/sig pairs), count via return */
+int   gen2elf_natives(const char ***names, const char ***sigs);
+/* last N log lines (engine __android_log + loader diagnostics) */
+const char *gen2elf_log(void);
+#endif
