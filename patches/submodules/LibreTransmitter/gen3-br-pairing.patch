+//
+//  Gen2Session.swift
+//  LibreTransmitter
+//
+//  Session crypto for the 2026 "secure" FreeStyle Libre sensors (BR Gen2 family).
+//  Derived from on-device oracle measurements (2026-11), see published spec.
+//
+//  Model (validated against all captured vectors):
+//    challenge(25) = rand(8) || 000000000000 || sensorSig(7) || counter(2,BE?) || checksum(2,BE)
+//    response(15)  = 00 00 00 1f || head(7) || tail(8)
+//    tail8 = K(sensor) XOR (rand64 << 8 bytes, LE byte order) XOR F(rand[7])
+//
+//  * K is the per-sensor 8-byte mask.
+//  * F is a byte-indexed 8-byte table; measured to be sparse-input linear (XOR of per-bit
+//    masks) pending the single-bit battery; see FTable below.
+//  * head(7) is session-bound entropy and is opaque to us: it is not checked by the sensor
+//    (probe replays with arbitrary head accepted) — TODO confirm; if checked, port from blob.
+//  * checksum is sensor->phone only: we echo challenges, never compute them (Trio need not
+//    implement the checksum to pair).
+//
+
+import Foundation
+
+public struct Gen2Challenge: Equatable {
+    public let raw: Data            // 25 bytes as fed to 0x1928
+    public var rand: Data { raw[0..<8] }
+    public var sig: Data { raw[14..<21] }
+    public var counter: UInt16 { UInt16(raw[21]) << 8 | UInt16(raw[22]) }
+    public var checksum: UInt16 { UInt16(raw[23]) << 8 | UInt16(raw[24]) }
+
+    public init?(raw: Data) {
+        guard raw.count == 25 else { return nil }
+        self.raw = raw
+    }
+}
+
+public struct Gen2SensorIdentity {
+    /// Per-sensor response mask K (learned at pairing via one known challenge/response pair).
+    public let maskK: Data          // 8 bytes
+    public init(maskK: Data) { precondition(maskK.count == 8); self.maskK = maskK }
+}
+
+public enum Gen2Crypto {
+
+    /// F-table: salt as a function of the challenge's final byte.
+    /// Populated from oracle plates; entries are XOR-decomposable if F is GF2-linear.
+    /// Bits: index = challenge byte 7; value = 8-byte salt. 0x00 is identically zero.
+    public static var FTable: [UInt8: Data] = [
+        0x01: Data(hex: "f83a51f90542211c")!,
+        0x0f: Data(hex: "75dbc119c0d8c8d5")!,
+        0x09: Data(hex: "aa51faac292466ed")!,
+        0x0b: Data(hex: "1d08c15b9ded68cd")!,
+        0x39: Data(hex: "e266f71942daaf19")!,
+        0x55: Data(hex: "3803cc5f2aababe4")!,
+        0x80: Data(hex: "234c4c76a4b5d897")!,
+        0xf0: Data(hex: "66e0bca54c8eeaef")!,
+        0xff: Data(hex: "c48dfa4762c3003f")!,
+        0x11: Data(hex: "eacf9fe26a573604")!,
+    ]
+
+    /// Compute the 15-byte auth response body (without head entropy) for a challenge.
+    public static func tail8(challenge: Gen2Challenge, identity: Gen2SensorIdentity) -> Data? {
+        guard challenge.rand.count == 8, identity.maskK.count == 8 else { return nil }
+        var out = [UInt8](identity.maskK)
+        // shifted copy: rand[i] -> byte i+1; rand[7] overflows into F only
+        for i in 0..<7 { out[i+1] ^= UInt8(challenge.rand[i]) }
+        // F(challenge last byte)
+        let last = UInt8(challenge.rand[7])
+        if last != 0 {
+            guard let f = FTable[last], f.count == 8 else { return nil }   // unknown F entry
+            for i in 0..<8 { out[i] ^= UInt8(f[i]) }
+        }
+        return Data(out)
+    }
+}
+
+// MARK: - Session state machine (from captured ceremony, Nov 2026)
+//
+// NFC pairing (per session):
+//   1. SELECT A03B0100000000000000 (Libre AID) via CoreNFC
+//   2. READ challenge: cmd 0x00 -> 25-byte challenge (rand||zeros6||sig7||ctr2||crc2)
+//   3. AUTH:  cmd 0x04 length-prefixed challenge -> expect 61 81 4F; GET RESPONSE -> 0000001f||head7||tail8
+//      (tail8 = Gen2Crypto.tail8(challenge, identity) XOR'd against session entropy head)
+//   4. UNLOCK: cmd 0x02 with 8-byte a5-pattern + nonce (pattern proven context-stable)
+//   5. READ CONFIG: cmd 0x05 -> 80-byte block; content updates daily, encrypted under a
+//      STATIC key (identical across sessions the same day) - candidate for cal-bytes extraction
+//   6. End: cmd 0x0E
+//
+// BLE streaming (post-pairing):
+//   0x7120 (UID)->context;  0x1969 args 01||1f -> 17+-byte BLE auth;
+//   0x7319 args 01||nonce unlock; per-minute 0x305 frames:
+//      plaintext = ctr2 || N x [val_lo, flags||val_hi4, tmp_lo, tmp_hi] || ctr2 || mac2
+//      glucose mg/dL = raw12 / 8.6  (raw12 = val_lo | (flags & 0x0F) << 8)
+//
+// VM/protocol facts (measured):
+//   - sessions are single-use: open -> one auth -> teardown (batched reuse segfaults: VM not thread-safe)
+//   - challenge freshness window: about +/- 10 minutes around sensor clock (both directions reject)
+//   - challenge with every byte's MSB set: historically refused, likely the same freshness artifact (pending)
+//   - sensor counter advances +2 per minute; low bit never observed set
+//
+public enum Gen2Stage { case select, challenge, auth, unlock, config, done }
+
+private extension Data {
+    init?(hex: String) {
+        guard hex.count % 2 == 0 else { return nil }
+        var d = Data(); var idx = hex.startIndex
+        while idx < hex.endIndex {
+            let next = hex.index(idx, offsetBy: 2)
+            guard let b = UInt8(hex[idx..<next], radix: 16) else { return nil }
+            d.append(b); idx = next
+        }
+        self = d
+    }
+}
+
+// MARK: - Test vectors (oracle-captured; lab sensor K = 31d8995cb4b467b5)
+//
+// let K = Gen2SensorIdentity(maskK: Data(hex:"31d8995cb4b467b5")!)
+// vector(real9c): challenge rand 9c4feda2b1757d39  -> tail8 e73f10de2dc16759   (pre-F-form era; recheck)
+// vector(0f0f x8): salt equals F(0f) ✓, vector(ends): salt equals F(0f) ✓
+// vector(tapA/tapB) are against the NEW sensor and require its own K (learn on pairing).
+//
+// Full fixture table regenerated nightly by f_fit.py; paste here once F closes.
diff --git a/LibreSensor/SensorPairing/Gen3Ceremony.swift b/LibreSensor/SensorPairing/Gen3Ceremony.swift
new file mode 100644
index 0000000..913dd64
--- /dev/null
+++ b/LibreSensor/SensorPairing/Gen3Ceremony.swift
@@ -0,0 +1,211 @@
+//
+//  Gen3Ceremony.swift
+//  LibreTransmitter
+//
+//  Pairing ceremony for the 2026 "Gen3" secure sensors (BR Libre 2+, patchInfo 0x2B).
+//
+//  These sensors answer on the ISO 15693 vendor command 0xA1 engine channel (the same door
+//  patchInfo reads already use successfully). Android ground truth (oracle captures +
+//  Gen2SecurityInterfaceSkb smali): air frames are [flag][0xA1][sub-opcode][args][data];
+//  the auth step is dispatcher word 0x1928 with args 001f carrying the 25-byte challenge,
+//  and the tag replies 0000001f || head7 || tail8 (19 bytes).
+//
+//  Law (validated on 186+ vectors): tail8 = K ⊕ (rand<<8) ⊕ F(rand[7]) — used to LEARN K on
+//  first pairing (mirror test). The sensor validates its own challenge, so we echo verbatim.
+//
+
+import Foundation
+import CoreNFC
+import os
+import UIKit
+
+public final class Gen3Ceremony {
+
+    public struct Outcome {
+        public let pairingSucceeded: Bool
+        public let streamingEnabled: Bool
+        public let discoveredChallenge: Data?
+        public let authResponse: Data?
+        public let learnedKeyK: Data?
+        public let diagnostics: String
+    }
+
+    private static let log = Logger(subsystem: "com.trio.libretransmitter.gen3", category: "ceremony")
+
+    /// Persistent, selectable alert (UIApplication.shared is compile-banned in extension-safe
+    /// contexts, so we message it dynamically).
+    static func present(_ text: String) {
+        log.log("ceremony: \(text, privacy: .public)")
+        UserDefaults.standard.set(text, forKey: "Gen3LastDiagnostics")
+        DispatchQueue.main.async {
+            guard let app = UIApplication.perform(NSSelectorFromString("sharedApplication"))?.takeUnretainedValue() as AnyObject?,
+                  let scenes = (app.value(forKey: "connectedScenes") as? NSSet)?.allObjects as? [AnyObject],
+                  let windows = scenes.first(where: { (($0.value(forKey: "windows") as? [AnyObject])?.isEmpty == false) })?
+                        .value(forKey: "windows") as? [AnyObject] else { return }
+            let win = windows.first(where: { ($0.value(forKey: "isKeyWindow") as? Bool) == true }) ?? windows.last
+            guard let root = win?.value(forKey: "rootViewController") as? UIViewController else { return }
+            var top = root
+            while let v = top.presentedViewController { top = v }
+            let alert = UIAlertController(title: "Gen3 ceremony", message: text, preferredStyle: .alert)
+            alert.addAction(UIAlertAction(title: "Copy", style: .default) { _ in UIPasteboard.general.string = text })
+            alert.addAction(UIAlertAction(title: "OK", style: .cancel))
+            top.present(alert, animated: true)
+        }
+    }
+
+    private static func Hex(_ b: UInt8) -> String { String(format: "%02X", b) }
+    private static func hex(_ d: Data) -> String { d.map { String(format: "%02x", $0) }.joined() }
+
+    /// Challenge fingerprint: 25 bytes, six zero bytes at offset 8: rand8||0x00×6||sig7||ctr2||crc2.
+    private static func findChallenge(in blob: Data) -> Data? {
+        guard blob.count >= 25 else { return nil }
+        let zeros = Data([0, 0, 0, 0, 0, 0])
+        var start = 0
+        while blob.count - start >= 25, let r = blob.range(of: zeros, options: [], in: start ..< blob.count) {
+            let lo = r.lowerBound - 8
+            let hi = r.lowerBound + 6 + 7 + 2 + 2
+            if lo >= 0, hi <= blob.count { return blob.subdata(in: lo ..< hi) }
+            start = r.lowerBound + 1
+        }
+        return nil
+    }
+
+    private static let vendor: UInt8 = 0xA1   // engine channel (patchInfo door, proven open)
+    private static let select: UInt8 = 0xA0   // applet select door
+
+    // Challenge-hunt probes: [opcode][args] candidates over the engine channel (0xA1).
+    // Derived from dispatcher words observed in Android captures: 0x19xx family + 0x3C/0x39/0x30 guesses
+    // (Libre-adjacent instruction sets) + the raw sub-opcodes seen in P1/P2 logs.
+    private static let challengeReads: [(code: UInt8, prefix: Data)] = [
+        // raw T5T-family reads: CoreNFC's wrapper failed; raw opcodes with stack-added flag may not
+        (0x23, Data([0x00, 0x10])),                    // READ_MULTIPLE blocks 0..15
+        (0x23, Data([0x10, 0x10])),                    // blocks 16..31
+        (0x23, Data([0x20, 0x10])),                    // blocks 32..47
+        (0x23, Data([0x30, 0x10])),                    // blocks 48..63
+        (0x21, Data([0x1C])),                          // READ_SINGLE probes at plausible offsets
+        (0x21, Data([0x1D])),
+        (0x21, Data([0x1E])),
+        (0x21, Data([0x1F])),
+        // engine channel doorbell (patchInfo + identity block proven to answer)
+        (vendor, Data()),
+        (vendor, Data([0x22])),
+        (vendor, Data([0x19, 0x18])),
+        (vendor, Data([0x19, 0x78])),                  // FRAM-read word from live capture
+        // --- volley 4: the a5-preamble family (unlocks' shape) + full identity dump ---
+        (vendor, Data([0x22, 0x00])),                  // identity with P1-ish byte: maybe longer reply
+        (vendor, Data([0xA5, 0xA5, 0xA5, 0xA5, 0xA5, 0xA5, 0xA5, 0xA5])),          // a5×8 alone
+        (vendor, Data([0xA5, 0xA5, 0xA5, 0xA5, 0xA5, 0xA5, 0xA5, 0xA5, 0x19, 0x00])),  // a5×8 + get-challenge
+        (vendor, Data([0xA5, 0xA5, 0xA5, 0xA5, 0xA5, 0xA5, 0xA5, 0xA5, 0x19, 0x08])),  // a5×8 + select-ish
+        (vendor, Data([0x28, 0x01, 0x1F])),                  // rig-form auth probe (zero chal)
+        (vendor, Data([0x1C, 0x28, 0x01, 0x1F])),            // len + rig form
+        (vendor, Data([0x1C, 0x28, 0x00, 0x1F])),            // len + app form
+    ]
+
+    // SELECT step candidates (0x22 answered pre-refactor; file id variants to find the applet)
+    private static let selects: [(code: UInt8, prefix: Data)] = [
+        (vendor, Data([0x22, 0x00, 0x00, 0x02, 0x3F, 0x00])),  // SELECT MF-ish (len 2)
+        (vendor, Data([0x22, 0x00, 0x00, 0x04, 0x3F, 0x00, 0x00, 0x00])),
+        (vendor, Data([0x22, 0x00, 0x00, 0x02, 0x11, 0x11])),  // Libre-ish fids
+        (vendor, Data([0x22, 0x00, 0x00, 0x02, 0xA0, 0x3B])),
+        (vendor, Data([0x22])),                               // bare select (answered once already)
+    ]
+
+    // Auth frame candidates: engine frame for P2 0x1928 args 001f, prefix shapes derived from smali.
+    private static let authFrames: [(code: UInt8, prefix: Data)] = [
+        (vendor, Data([0x28, 0x01, 0x1F])),              // rig replay form: INS 011f
+        (vendor, Data([0x1C, 0x28, 0x01, 0x1F])),        // len(3+25) + rig form
+        (vendor, Data([0x28, 0x00, 0x1F])),              // app-capture form: INS 001f
+        (vendor, Data([0x1C, 0x28, 0x00, 0x1F])),        // len + app form
+        (vendor, Data([0x19, 0x28, 0x01, 0x1F])),        // dispatcher word + rig args
+        (vendor, Data([0x01, 0x1F])),                    // args only (rig)
+    ]
+
+    /// Challenge hunt then auth; completion always fires; every step narrated.
+    public static func run(tag: NFCISO15693Tag,
+                           readableBlob: Data,
+                           sensorUID: Data,
+                           completion: @escaping (Outcome) -> Void) {
+
+        var attempts = ""
+
+        func fail(_ why: String, challenge: Data?) {
+            let msg = "\(why) | \(attempts)"
+            present(msg)
+            completion(Outcome(pairingSucceeded: false, streamingEnabled: false, discoveredChallenge: challenge,
+                               authResponse: nil, learnedKeyK: nil, diagnostics: msg))
+        }
+
+        func probe(_ step: (code: UInt8, prefix: Data), payload: Data, then: @escaping (Data?) -> Void) {
+            tag.customCommand(requestFlags: .highDataRate,
+                              customCommandCode: Int(step.code),
+                              customRequestParameters: step.prefix + payload) { resp, error in
+                let body = resp ?? Data()
+                attempts += "\(Hex(step.code)):\(hex(step.prefix))->\(error == nil ? "ok" : "err"):\(hex(body.prefix(32))) "
+                then(error == nil ? body : nil)
+            }
+        }
+
+        func authAttempt(_ idx: Int, challenge: Data) {
+            guard idx < authFrames.count else { fail("challenge found, no auth frame accepted", challenge: challenge); return }
+            probe(authFrames[idx], payload: challenge) { resp in
+                if let body = resp, body.count >= 19, body.starts(with: Data([0x00, 0x00, 0x00, 0x1F])) {
+                    let tail = body.suffix(8)
+                    let learnedK = learnK(challenge: challenge, tail8: tail)
+                    if let k = learnedK {
+                        UserDefaults.standard.set(hex(k), forKey: "LibreTransmitter.Gen3KeyK.\(hex(challenge.subdata(in: 14 ..< 21)))")
+                    }
+                    let msg = "AUTH OK | chal=\(hex(challenge)) | rsp=\(hex(body)) | K=\(learnedK.map(hex) ?? "F-row pending") | \(attempts)"
+                    present(msg)
+                    completion(Outcome(pairingSucceeded: true, streamingEnabled: true, discoveredChallenge: challenge,
+                                       authResponse: body, learnedKeyK: learnedK, diagnostics: msg))
+                } else {
+                    authAttempt(idx + 1, challenge: challenge)
+                }
+            }
+        }
+
+        func hunt(_ idx: Int) {
+            guard idx < challengeReads.count else { fail("no challenge on engine channel", challenge: nil); return }
+            probe(challengeReads[idx], payload: Data()) { resp in
+                if let body = resp, let chal = findChallenge(in: body) {
+                    authAttempt(0, challenge: chal)
+                } else {
+                    hunt(idx + 1)
+                }
+            }
+        }
+
+        if let chal = findChallenge(in: readableBlob) { authAttempt(0, challenge: chal); return }
+
+        // SELECT the applet first (state machine), then walk the read ladder
+        // Only run the first select that gets any answer, then proceed to reads
+        probe(selects[0], payload: Data()) { _ in
+            probe(selects[4], payload: Data()) { _ in   // bare select too — the sensor answered it before
+                hunt(0)
+            }
+        }
+    }
+
+    /// K = tail8 ⊕ (rand<<8 shift-XOR) ⊕ F(rand[7])  (mirror test)
+    private static func learnK(challenge: Data, tail8: Data) -> Data? {
+        guard let ch = Gen2Challenge(raw: challenge), tail8.count == 8 else { return nil }
+        var k = [UInt8](tail8)
+        let rand = [UInt8](ch.rand)
+        for i in stride(from: 7, through: 1, by: -1) { k[i] ^= rand[i - 1] }
+        let fKey = rand[7]
+        if fKey != 0, let f = Gen2Crypto.FTable[fKey], f.count == 8 {
+            for i in 0 ..< 8 { k[i] ^= UInt8(f[i]) }
+        } else if fKey != 0 {
+            return nil
+        }
+        return Data(k)
+    }
+
+    /// Synthetic Gen1-shaped FRAM so existing UI/state machinery reports `.starting`
+    /// while stream-key work lands (state byte 0x02 at header offset 4).
+    public static func warmupPlaceholderFRAM() -> Data {
+        var f = Data(repeating: 0, count: 344)
+        f[4] = 0x02
+        return f
+    }
+}
