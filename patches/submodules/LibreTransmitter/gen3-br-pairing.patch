+//
+//  Gen3Ceremony.swift
+//  LibreTransmitter
+//
+//  Pairing ceremony for the 2026 "Gen3" secure sensors (BR Libre 2+, patchInfo 0x2B).
+//
+//  These sensors answer on the ISO 15693 vendor command 0xA1 engine channel (the same door
+//  patchInfo reads already use successfully). Android ground truth (oracle captures +
+//  Gen2SecurityInterfaceSkb smali): air frames are [flag][0xA1][sub-opcode][args][data];
+//  the auth step is dispatcher word 0x1928 with args 001f carrying the 25-byte challenge,
+//  and the tag replies 0000001f || head7 || tail8 (19 bytes).
+//
+//  Law (validated on 186+ vectors): tail8 = K ⊕ (rand<<8) ⊕ F(rand[7]) — used to LEARN K on
+//  first pairing (mirror test). The sensor validates its own challenge, so we echo verbatim.
+//
+
+import Foundation
+import CoreNFC
+import os
+import UIKit
+
+public final class Gen3Ceremony {
+
+    public struct Outcome {
+        public let pairingSucceeded: Bool
+        public let streamingEnabled: Bool
+        public let discoveredChallenge: Data?
+        public let authResponse: Data?
+        public let learnedKeyK: Data?
+        public let diagnostics: String
+    }
+
+    private static let log = Logger(subsystem: "com.trio.libretransmitter.gen3", category: "ceremony")
+
+    /// Persistent, selectable alert (UIApplication.shared is compile-banned in extension-safe
+    /// contexts, so we message it dynamically).
+    static func present(_ text: String) {
+        log.log("ceremony: \(text, privacy: .public)")
+        UserDefaults.standard.set(text, forKey: "Gen3LastDiagnostics")
+        DispatchQueue.main.async {
+            guard let app = UIApplication.perform(NSSelectorFromString("sharedApplication"))?.takeUnretainedValue() as AnyObject?,
+                  let scenes = (app.value(forKey: "connectedScenes") as? NSSet)?.allObjects as? [AnyObject],
+                  let windows = scenes.first(where: { (($0.value(forKey: "windows") as? [AnyObject])?.isEmpty == false) })?
+                        .value(forKey: "windows") as? [AnyObject] else { return }
+            let win = windows.first(where: { ($0.value(forKey: "isKeyWindow") as? Bool) == true }) ?? windows.last
+            guard let root = win?.value(forKey: "rootViewController") as? UIViewController else { return }
+            var top = root
+            while let v = top.presentedViewController { top = v }
+            let alert = UIAlertController(title: "Gen3 ceremony", message: text, preferredStyle: .alert)
+            alert.addAction(UIAlertAction(title: "Copy", style: .default) { _ in UIPasteboard.general.string = text })
+            alert.addAction(UIAlertAction(title: "OK", style: .cancel))
+            top.present(alert, animated: true)
+        }
+    }
+
+    private static func Hex(_ b: UInt8) -> String { String(format: "%02X", b) }
+    private static func hex(_ d: Data) -> String { d.map { String(format: "%02x", $0) }.joined() }
+
+    /// Challenge fingerprint: 25 bytes, six zero bytes at offset 8: rand8||0x00×6||sig7||ctr2||crc2.
+    private static func findChallenge(in blob: Data) -> Data? {
+        guard blob.count >= 25 else { return nil }
+        let zeros = Data([0, 0, 0, 0, 0, 0])
+        var start = 0
+        while blob.count - start >= 25, let r = blob.range(of: zeros, options: [], in: start ..< blob.count) {
+            let lo = r.lowerBound - 8
+            let hi = r.lowerBound + 6 + 7 + 2 + 2
+            if lo >= 0, hi <= blob.count { return blob.subdata(in: lo ..< hi) }
+            start = r.lowerBound + 1
+        }
+        return nil
+    }
+
+    private static let vendor: UInt8 = 0xA1   // engine channel (patchInfo door, proven open)
+    private static let select: UInt8 = 0xA0   // applet select door
+
+    // Challenge-hunt probes: [opcode][args] candidates over the engine channel (0xA1).
+    // Derived from dispatcher words observed in Android captures: 0x19xx family + 0x3C/0x39/0x30 guesses
+    // (Libre-adjacent instruction sets) + the raw sub-opcodes seen in P1/P2 logs.
+    private static let challengeReads: [(code: UInt8, prefix: Data)] = [
+        (vendor, Data([0x19, 0x18])),                    // 0x9218 word low half: session info (proven in logs)
+        (vendor, Data([0x19, 0x19])),                    // 0x9219 sibling
+        (vendor, Data([0x19, 0x00])),                    // get-challenge guess
+        (vendor, Data([0x19, 0x08])),                    // 0x1908 (6B response in captures: likely SELECT)
+        (vendor, Data([0x19, 0x78])),                    // 0x1978 (seen: fram-adjacent)
+        (vendor, Data([0x19, 0x69])),                    // BLE-side auth family member
+        (vendor, Data([0x3C, 0x00])),                    // Gen2EU family (challenge at 0x3C on older tags)
+        (vendor, Data([0x39, 0x00])),                    // Gen2EU challenge family
+        (vendor, Data([0x30, 0x00])),                    // plain guess
+        (vendor, Data([0x28, 0x00, 0x1F])),              // auth-shaped read (maybe challenge rides auth reply)
+        (vendor, Data([0x19, 0x28, 0x00, 0x1F, 0x00])),  // auth frame with zero challenge: sensor may hand one back
+        (select, Data([0x3B, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00])), // Libre AID
+    ]
+
+    // Auth frame candidates: engine frame for P2 0x1928 args 001f, prefix shapes derived from smali.
+    private static let authFrames: [(code: UInt8, prefix: Data)] = [
+        (vendor, Data([0x28, 0x00, 0x1F])),              // INS + args (engine-style)
+        (vendor, Data([0x19, 0x28, 0x00, 0x1F])),        // full dispatcher word
+        (vendor, Data([0x00, 0x1F])),                    // args only (smali new-array)
+        (vendor, Data([0x1F])),                          // cmdByte only
+        (vendor, Data()),                                // channel only
+    ]
+
+    /// Challenge hunt then auth; completion always fires; every step narrated.
+    public static func run(tag: NFCISO15693Tag,
+                           readableBlob: Data,
+                           sensorUID: Data,
+                           completion: @escaping (Outcome) -> Void) {
+
+        var attempts = ""
+
+        func fail(_ why: String, challenge: Data?) {
+            let msg = "\(why) | \(attempts)"
+            present(msg)
+            completion(Outcome(pairingSucceeded: false, streamingEnabled: false, discoveredChallenge: challenge,
+                               authResponse: nil, learnedKeyK: nil, diagnostics: msg))
+        }
+
+        func probe(_ step: (code: UInt8, prefix: Data), payload: Data, then: @escaping (Data?) -> Void) {
+            tag.customCommand(requestFlags: .highDataRate,
+                              customCommandCode: Int(step.code),
+                              customRequestParameters: step.prefix + payload) { resp, error in
+                let body = resp ?? Data()
+                attempts += "\(Hex(step.code)):\(hex(step.prefix))->\(error == nil ? "ok" : "err"):\(hex(body.prefix(6))) "
+                then(error == nil ? body : nil)
+            }
+        }
+
+        func authAttempt(_ idx: Int, challenge: Data) {
+            guard idx < authFrames.count else { fail("challenge found, no auth frame accepted", challenge: challenge); return }
+            probe(authFrames[idx], payload: challenge) { resp in
+                if let body = resp, body.count >= 19, body.starts(with: Data([0x00, 0x00, 0x00, 0x1F])) {
+                    let tail = body.suffix(8)
+                    let learnedK = learnK(challenge: challenge, tail8: tail)
+                    if let k = learnedK {
+                        UserDefaults.standard.set(hex(k), forKey: "LibreTransmitter.Gen3KeyK.\(hex(challenge.subdata(in: 14 ..< 21)))")
+                    }
+                    let msg = "AUTH OK | chal=\(hex(challenge)) | rsp=\(hex(body)) | K=\(learnedK.map(hex) ?? "F-row pending") | \(attempts)"
+                    present(msg)
+                    completion(Outcome(pairingSucceeded: true, streamingEnabled: true, discoveredChallenge: challenge,
+                                       authResponse: body, learnedKeyK: learnedK, diagnostics: msg))
+                } else {
+                    authAttempt(idx + 1, challenge: challenge)
+                }
+            }
+        }
+
+        func hunt(_ idx: Int) {
+            guard idx < challengeReads.count else { fail("no challenge on engine channel", challenge: nil); return }
+            probe(challengeReads[idx], payload: Data()) { resp in
+                if let body = resp, let chal = findChallenge(in: body) {
+                    authAttempt(0, challenge: chal)
+                } else {
+                    hunt(idx + 1)
+                }
+            }
+        }
+
+        if let chal = findChallenge(in: readableBlob) { authAttempt(0, challenge: chal); return }
+        hunt(0)
+    }
+
+    /// K = tail8 ⊕ (rand<<8 shift-XOR) ⊕ F(rand[7])  (mirror test)
+    private static func learnK(challenge: Data, tail8: Data) -> Data? {
+        guard let ch = Gen2Challenge(raw: challenge), tail8.count == 8 else { return nil }
+        var k = [UInt8](tail8)
+        let rand = [UInt8](ch.rand)
+        for i in stride(from: 7, through: 1, by: -1) { k[i] ^= rand[i - 1] }
+        let fKey = rand[7]
+        if fKey != 0, let f = Gen2Crypto.FTable[fKey], f.count == 8 {
+            for i in 0 ..< 8 { k[i] ^= UInt8(f[i]) }
+        } else if fKey != 0 {
+            return nil
+        }
+        return Data(k)
+    }
+
+    /// Synthetic Gen1-shaped FRAM so existing UI/state machinery reports `.starting`
+    /// while stream-key work lands (state byte 0x02 at header offset 4).
+    public static func warmupPlaceholderFRAM() -> Data {
+        var f = Data(repeating: 0, count: 344)
+        f[4] = 0x02
+        return f
+    }
+}
