+static int route_is_transceive(const JMid *m) {
+    return m && (!strcmp(m->name,"transceive") || !strcmp(m->name,"sendData") ||
+                 !strcmp(m->name,"sendRaw")   || !strcmp(m->name,"sendApdu"));
