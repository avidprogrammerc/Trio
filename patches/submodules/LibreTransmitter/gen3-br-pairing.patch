+static void do_relocs(img *m, Rela *block, size_t bytes) {
+    for (size_t k = 0; k < bytes / 24; k++) {
+        Rela *r = (Rela*)((uint8_t*)block + k*24);
+        uint64_t *where = (uint64_t*)(m->base + r->offset - m->lo);
+        uint32_t type = (uint32_t)(r->info & 0xffffffff);
+        uint32_t si   = (uint32_t)(r->info >> 32);
+        if (type == R_RELATIVE) { *where = (uint64_t)m->base + r->addend; continue; }
+        if (type == 1032 || (type >= 1029 && type <= 1031)) {   /* R_AARCH64_IRELATIVE (1032) + TLS-resolver kin */
+            uint64_t (*res)(void) = (uint64_t(*)(void))((uint64_t)m->base + r->addend);
+            *where = res();
+            continue;
+        }
+        if (type == R_GLOB_DAT || type == R_JUMP_SLOT || type == R_ABS64) {
+            const char *nm = "?";
+            if (si && m->sym && m->str && m->sym[si].name < (1u<<20)) nm = m->str + m->sym[si].name;
+            void *p = resolve(nm);
+            if (!p) L("gen2elf: reloc %s -> NULL\n", nm);
+            *where = (uint64_t)p;
+            continue;
+        }
+        L("gen2elf: reloc type %u off %llx\n", type, (unsigned long long)r->offset);
+    }
+}
+static void relocate(img *m) {
+    do_relocs(m, m->rela, m->relasz);
+    if (m->jmprel) do_relocs(m, m->jmprel, m->jmprelsz);
+}
