+static jobject transceive_object(JNIEnv *e, jobject thiz, JMid *m, const uint8_t *in, int inlen) {
+    (void)e;(void)thiz;(void)m;
+    uint8_t out[512]; int outlen = 0;
+    if (!g_xs) { L("jni transceive before boot\n"); return 0; }
+    if (g_trace) {
+        L("X-in  n=%d ", inlen);
+        for (int q = 0; q < inlen; q++) L("%02x", in[q]); L("\n");
+    }
+    if (g_xs(g_xu, in, inlen, out, (int)sizeof out, &outlen)) return 0;
+    if (g_trace) {
+        L("X-out n=%d ", outlen);
+        for (int q = 0; q < outlen; q++) L("%02x", out[q]); L("\n");
+    }
+    JBA *a = my_NewByteArray(e, outlen);
+    memcpy(a->b, out, outlen);
+    return (jobject)a;
+}
