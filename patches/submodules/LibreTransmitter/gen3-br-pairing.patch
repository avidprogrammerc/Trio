+static void run_init(img *m) {
+    for (int k = 0; k < m->ninit; k++) {
+        void (*f)(void) = (void(*)(void))m->initarr[k];
+        if (g_trace) L("gen2elf: init %s[%d]=%p\n", m->name, k, (void*)f);
+        f();
+    }
+}
